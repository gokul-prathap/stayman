# Backend only. Never prefix these with VITE_. Use real values in an ignored
# .env.local file or in Supabase Dashboard > Edge Functions > Secrets.
AIOSELL_API_USERNAME=
AIOSELL_API_PASSWORD=
AIOSELL_API_BASE_URL=https://live.aiosell.com/api/v2/cm
AIOSELL_PARTNER_ID=sample-pms
AIOSELL_ALLOWED_ORIGINS=http://localhost:5173
# Choose dedicated inbound credentials and share them privately with Aiosell.
AIOSELL_WEBHOOK_USERNAME=
AIOSELL_WEBHOOK_PASSWORD=
# Generate a separate random token (32+ bytes) for the scheduler.
AIOSELL_WORKER_SECRET=
